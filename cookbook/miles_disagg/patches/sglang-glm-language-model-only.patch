@@ -0,0 +1,59 @@
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+from sglang.srt.managers import tokenizer_manager
+
+
+def test_standalone_language_model_does_not_start_encoder_disaggregation(monkeypatch):
+    monkeypatch.setattr(
+        tokenizer_manager,
+        "get_disagg",
+        lambda: SimpleNamespace(disaggregation_mode="null"),
+    )
+    create_receiver = Mock(side_effect=AssertionError("encoder receiver constructed"))
+    monkeypatch.setattr(tokenizer_manager, "create_mm_receiver", create_receiver)
+    manager = SimpleNamespace(
+        server_args=SimpleNamespace(language_only=False, language_model_only=True)
+    )
+
+    tokenizer_manager.TokenizerManager.init_disaggregation(
+        manager, start_pd_bootstrap_service=False
+    )
+
+    assert manager.encoder_bootstrap_server is None
+    create_receiver.assert_not_called()
+
+
+@pytest.mark.parametrize("multimodal", [False, True])
+def test_standalone_language_model_accepts_tokens_and_rejects_multimodal(multimodal):
+    request = SimpleNamespace(
+        text=None,
+        input_embeds=None,
+        input_ids=[3, 5, 8],
+        contains_mm_input=lambda: multimodal,
+    )
+    create = Mock(return_value="tokenized")
+    validate = Mock()
+    manager = SimpleNamespace(
+        server_args=SimpleNamespace(language_model_only=True),
+        model_config=SimpleNamespace(
+            hf_config=SimpleNamespace(
+                architectures=["Glm5NextForConditionalGeneration"]
+            )
+        ),
+        mm_processor=None,
+        _validate_one_request=validate,
+        _create_tokenized_object=create,
+    )
+    call = tokenizer_manager.TokenizerManager._tokenize_one_request(manager, request)
+
+    if multimodal:
+        with pytest.raises(ValueError, match="Multimodal inputs are not supported"):
+            asyncio.run(call)
+        create.assert_not_called()
+    else:
+        assert asyncio.run(call) == "tokenized"
+        validate.assert_called_once_with(request, [3, 5, 8])
+        create.assert_called_once_with(request, None, [3, 5, 8], None, None, None)
