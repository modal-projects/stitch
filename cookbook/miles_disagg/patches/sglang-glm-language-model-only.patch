@@ -0,0 +1,41 @@
+import pytest
+from sglang.srt.configs import model_config
+from transformers import LlamaConfig, PretrainedConfig
+
+
+@pytest.mark.parametrize(
+    "cli_only,checkpoint_only,epd,expected_only",
+    [
+        (False, False, False, False),
+        (True, False, False, True),
+        (False, True, False, True),
+        (False, False, True, False),
+    ],
+)
+def test_language_mode_metadata(
+    monkeypatch, tmp_path, cli_only, checkpoint_only, epd, expected_only
+):
+    hf_config = PretrainedConfig(
+        architectures=["Glm5NextForConditionalGeneration"],
+        language_model_only=checkpoint_only,
+    )
+    hf_config.text_config = LlamaConfig()
+    hf_config.vision_config = PretrainedConfig()
+    monkeypatch.setattr(model_config, "get_config", lambda *a, **k: hf_config)
+    monkeypatch.setattr(model_config, "get_generation_config", lambda *a, **k: None)
+    for method in (
+        "_derive_context_length",
+        "_derive_model_shapes",
+        "_derive_hybrid_model",
+    ):
+        monkeypatch.setattr(model_config.ModelConfig, method, lambda *a, **k: None)
+
+    result = model_config.ModelConfig(
+        str(tmp_path), language_model_only=cli_only, language_only=epd
+    )
+
+    assert result.is_lm_only is expected_only
+    assert result.is_multimodal is not expected_only
+    assert result.is_image_understandable_model is not expected_only
+    assert result.hf_config.language_model_only is expected_only
+    assert result.hf_config.language_only is epd
