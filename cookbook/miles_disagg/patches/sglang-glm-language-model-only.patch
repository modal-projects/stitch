diff --git a/python/sglang/srt/server_args_test.py b/python/sglang/srt/server_args_test.py
new file mode 100644
--- /dev/null
+++ b/python/sglang/srt/server_args_test.py
@@ -0,0 +1,47 @@
+from types import SimpleNamespace
+
+import pytest
+from sglang.srt.server_args import ServerArgs
+
+
+@pytest.mark.parametrize(
+    "architecture",
+    ["Glm5NextForConditionalGeneration", "MuseGlimmerForConditionalGeneration"],
+)
+def test_language_model_only_accepts_supported_architecture(architecture):
+    args = _language_model_args(architecture)
+    ServerArgs._handle_language_model_only(args)
+
+
+@pytest.mark.parametrize(
+    "conflict", ["encoder_only", "language_only", "mm_enable_dp_encoder"]
+)
+def test_language_model_only_rejects_encoder_modes(conflict):
+    args = _language_model_args("Glm5NextForConditionalGeneration")
+    setattr(args, conflict, True)
+    with pytest.raises(ValueError, match="cannot be combined"):
+        ServerArgs._handle_language_model_only(args)
+
+
+def test_language_model_only_still_rejects_unsupported_architecture():
+    args = _language_model_args("UnsupportedForConditionalGeneration")
+    with pytest.raises(ValueError, match="does not support"):
+        ServerArgs._handle_language_model_only(args)
+    args.language_model_only = False
+    ServerArgs._handle_language_model_only(args)
+
+
+def _language_model_args(architecture):
+    return SimpleNamespace(
+        language_model_only=True,
+        language_only=False,
+        encoder_only=False,
+        enable_prefix_mm_cache=False,
+        enable_broadcast_mm_inputs_process=False,
+        mm_enable_dp_encoder=False,
+        disaggregation_mode="null",
+        LANGUAGE_MODEL_ONLY_ARCHITECTURES=ServerArgs.LANGUAGE_MODEL_ONLY_ARCHITECTURES,
+        get_model_config=lambda: SimpleNamespace(
+            hf_config=SimpleNamespace(architectures=[architecture])
+        ),
+    )
