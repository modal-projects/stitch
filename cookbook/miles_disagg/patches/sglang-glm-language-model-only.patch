+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+from sglang.srt.models import glm5_next as glm
+
+
+class _LanguageModel(torch.nn.Module):
+    def __init__(self, *args, **kwargs):
+        super().__init__()
+        self.embed_tokens = torch.nn.Embedding(8, 4)
+        self.layers = []
+
+
+@pytest.mark.parametrize(
+    "language_only,language_model_only,encoder_only",
+    [
+        (False, False, False),
+        (True, False, False),
+        (False, True, False),
+        (False, False, True),
+    ],
+)
+def test_language_modes_construct_and_load_matching_components(
+    monkeypatch, language_only, language_model_only, encoder_only
+):
+    config = SimpleNamespace(
+        language_only=language_only,
+        language_model_only=language_model_only,
+        encoder_only=encoder_only,
+        text_config=SimpleNamespace(
+            q_lora_rank=None,
+            tie_word_embeddings=False,
+            vocab_size=8,
+            hidden_size=4,
+            mhc=False,
+            rope_scaling={},
+            n_routed_experts=2,
+            num_hidden_layers=45,
+            num_nextn_predict_layers=1,
+        ),
+        vision_config=SimpleNamespace(),
+    )
+    visual = Mock(return_value=torch.nn.Identity())
+    monkeypatch.setattr(glm, "Glm5NextModel", _LanguageModel)
+    monkeypatch.setattr(glm, "Glm5NextVisionModel", visual)
+    monkeypatch.setattr(glm, "LogitsProcessor", lambda *a, **k: torch.nn.Identity())
+    monkeypatch.setattr(glm, "ParallelLMHead", lambda *a, **k: torch.nn.Identity())
+    monkeypatch.setattr(glm, "get_parallel", lambda: SimpleNamespace(tp_size=1))
+    monkeypatch.setattr(
+        glm, "get_pp_group", lambda: SimpleNamespace(is_last_rank=True, world_size=1)
+    )
+    monkeypatch.setattr(
+        glm,
+        "get_attn_tp_context",
+        lambda: SimpleNamespace(init_context=lambda *a, **k: None),
+    )
+    monkeypatch.setattr(glm, "is_deepseek_dsa", lambda *a: False)
+    monkeypatch.setattr(glm, "is_dsa_enable_prefill_cp", lambda: False)
+    monkeypatch.setattr(glm, "is_prefill_context_parallel_enabled", lambda: False)
+    monkeypatch.setattr(
+        glm,
+        "get_server_args",
+        lambda: SimpleNamespace(mm_enable_dp_encoder=False, enable_dp_lm_head=False),
+    )
+    monkeypatch.setattr(
+        glm.Glm5NextForConditionalGeneration,
+        "determine_num_fused_shared_experts",
+        lambda *a: None,
+    )
+    monkeypatch.setattr(
+        glm.vision_utils, "update_vit_attn_dummy_heads_config", lambda *a: None
+    )
+    monkeypatch.setattr(
+        glm.vision_utils, "pad_vit_attn_dummy_heads", lambda config, name, value: value
+    )
+    monkeypatch.setattr(
+        glm.DeepseekV2WeightLoaderMixin, "post_load_weights", lambda *a, **k: None
+    )
+
+    model = glm.Glm5NextForConditionalGeneration(config)
+    text_only = language_only or language_model_only
+    assert (model.visual is None) is text_only
+    assert visual.call_count == (0 if text_only else 1)
+    assert (model.model is None) is encoder_only
+    if not encoder_only:
+        assert "model.embed_tokens.weight" in dict(model.named_parameters())
+
+    text = SimpleNamespace(weight_loader=Mock())
+    vision = SimpleNamespace(weight_loader=Mock())
+    mtp = SimpleNamespace(weight_loader=Mock())
+    parameters = {
+        "model.embed_tokens.weight": text,
+        "visual.blocks.0.mlp.down_proj.weight": vision,
+        "model.layers.45.input_layernorm.weight": mtp,
+    }
+    monkeypatch.setattr(model, "named_parameters", lambda: parameters.items())
+    value = torch.ones(1)
+    model.load_weights(
+        [
+            ("model.language_model.embed_tokens.weight", value),
+            ("model.visual.blocks.0.mlp.down_proj.weight", value),
+            ("model.language_model.layers.45.input_layernorm.weight", value),
+        ]
+    )
+    assert text.weight_loader.call_count == (0 if encoder_only else 1)
+    assert vision.weight_loader.call_count == (0 if text_only else 1)
+    mtp.weight_loader.assert_not_called()
