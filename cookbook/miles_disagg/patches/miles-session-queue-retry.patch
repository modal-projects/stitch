 def _transport_error_is_safe_to_retry(exc: httpx.TransportError) -> bool:
     """Whether httpx failed before a stateful request could reach the server."""
     return isinstance(exc, (httpx.ConnectError, httpx.ConnectTimeout, httpx.PoolTimeout))
+
+
+def _response_is_safe_to_retry(response: httpx.Response) -> bool:
+    if response.status_code in (409, 429):
+        return True
+    if response.status_code != 503:
+        return False
+    # Modal rejects capacity overflow before dispatching it to a container.
+    if response.text.strip() == "Server is at capacity":
+        return True
+    try:
+        body = response.json()
+    except ValueError:
+        return False
+    if not isinstance(body, dict):
+        return False
+    error = body.get("error")
+    message = error.get("message") if isinstance(error, dict) else body.get("detail")
+    # SGLang rejects this request before generation, so its session can be retried.
+    return message == "The request queue is full."
 
 
