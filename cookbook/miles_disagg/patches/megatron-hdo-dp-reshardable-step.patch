+def merge_local_nonpersistent_values(
+    persistent: Union[dict, list, U], local: Union[dict, list, U]
+) -> Union[dict, list, U]:
+    """Overlay locally reconstructed values onto loaded persistent state.
+
+    ``LocalNonpersistentObject`` declares that the value supplied by the load
+    template is authoritative. This also applies when a value that is local in
+    the current schema was persisted by an older checkpoint. In that case the
+    local container shape is authoritative, while unrelated persistent values
+    in overlapping dictionaries are preserved.
+    """
+    if isinstance(persistent, dict) and isinstance(local, dict):
+        for key, local_value in local.items():
+            if key in persistent:
+                persistent[key] = merge_local_nonpersistent_values(
+                    persistent[key], local_value
+                )
+            else:
+                persistent[key] = local_value
+        return persistent
+
+    if isinstance(persistent, list) and isinstance(local, list):
+        common_length = min(len(persistent), len(local))
+        for index in range(common_length):
+            persistent[index] = merge_local_nonpersistent_values(
+                persistent[index], local[index]
+            )
+        if len(persistent) > len(local):
+            del persistent[len(local) :]
+        elif len(persistent) < len(local):
+            persistent.extend(local[len(persistent) :])
+        return persistent
+
+    return local
+
+
