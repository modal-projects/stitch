--- /dev/null
+++ b/python/sglang/srt/layers/attention/dsa/kpool_fp8_index_test.py
@@ -0,0 +1,121 @@
+import pytest
+
+
+@pytest.fixture(scope="module")
+def runtime():
+    torch = pytest.importorskip("torch")
+    pytest.importorskip("sglang")
+    if not torch.cuda.is_available():
+        pytest.skip("KPOOL selection requires CUDA")
+    pytest.importorskip("flashinfer")
+    from sglang.srt.layers.attention.dsa.dsa_topk_backend import DSATopKBackend
+    from sglang.srt.layers.attention.dsa.kpool_fp8_index import (
+        topk_from_pooled_history_logits,
+    )
+
+    return torch, DSATopKBackend, topk_from_pooled_history_logits
+
+
+@pytest.mark.parametrize(
+    "tokens,pattern",
+    [
+        (3, "ties"),
+        (2048, "ties"),
+        (2049, "unique"),
+        (2052, "unique"),
+        (8193, "ties"),
+        (32769, "narrow_unique"),
+    ],
+)
+@pytest.mark.parametrize("mapping", ["raw", "ragged", "paged"])
+def test_configured_topk_matches_reference_and_cuda_graph(
+    runtime, monkeypatch, tokens, pattern, mapping
+):
+    torch, DSATopKBackend, topk_from_pooled_history_logits = runtime
+    monkeypatch.setenv("SGLANG_DSA_TOPK_FLASHINFER_DETERMINISTIC", "1")
+    monkeypatch.setenv("SGLANG_DSA_TOPK_FLASHINFER_TIE_BREAK", "large")
+    sequences = [tokens, min(tokens, 2052), min(tokens, 2049), min(tokens, 3)]
+    lengths = [length // 4 for length in sequences]
+    starts = [0, 1, 2, 3]
+    logits = torch.full((4, max(lengths) + 4), 10000.0, dtype=torch.float32)
+    reference = []
+    generator = torch.Generator().manual_seed(514)
+    for row, count in enumerate(lengths):
+        scores = torch.randperm(count, generator=generator).float()
+        if pattern == "ties":
+            scores.fill_(1)
+        elif pattern == "narrow_unique":
+            scores = 1 + scores * 2**-23
+        logits[row, starts[row] : starts[row] + count] = scores
+        selected = sorted(
+            range(count), key=lambda i: (float(scores[i]), i), reverse=True
+        )[:512]
+        raw = [4 * group + offset for group in sorted(selected) for offset in range(4)]
+        raw.extend(range(4 * count, sequences[row]))
+        reference.append(raw + [-1] * (2051 - len(raw)))
+    reference.append([-1] * 2051)
+    reference = torch.tensor(reference, dtype=torch.int32, device="cuda")
+    logits = logits.cuda()
+    lengths = torch.tensor(lengths, dtype=torch.int32, device="cuda")
+    kwargs = dict(
+        seq_lens=torch.tensor(sequences, dtype=torch.int32, device="cuda"),
+        row_starts=torch.tensor(starts, dtype=torch.int32, device="cuda"),
+        out_rows=5,
+        return_raw_indices=True,
+        topk_backend=DSATopKBackend.FLASHINFER,
+    )
+    expected = reference.clone()
+    if mapping == "ragged":
+        offsets = (
+            torch.arange(4, device="cuda", dtype=torch.int32)[:, None] * 100000 + 17
+        )
+        kwargs["topk_offsets"] = offsets
+        expected[:4] = (reference[:4] + offsets).masked_fill(reference[:4] < 0, -1)
+    elif mapping == "paged":
+        table = torch.arange(tokens, device="cuda", dtype=torch.int32).flip(0)
+        kwargs["page_table"] = torch.stack((table, table + 100000))
+        rows = torch.tensor([0, 1, 0, 1], device="cuda", dtype=torch.int32)
+        kwargs["page_table_row_index"] = rows
+        expected[:4] = (
+            tokens - 1 - reference[:4] + rows[:, None] * 100000
+        ).masked_fill(reference[:4] < 0, -1)
+
+    def select():
+        return topk_from_pooled_history_logits(logits, lengths, 4, 2048, **kwargs)
+
+    for _ in range(8):
+        actual, raw = select()
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+        torch.testing.assert_close(raw, reference, rtol=0, atol=0)
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        select()
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual, raw = select()
+    for _ in range(3):
+        graph.replay()
+        torch.cuda.synchronize()
+        torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+        torch.testing.assert_close(raw, reference, rtol=0, atol=0)
+
+
+def test_default_backend_keeps_complete_history_and_tail(runtime):
+    torch, _, topk_from_pooled_history_logits = runtime
+    logits = torch.randn(1, 512, device="cuda", dtype=torch.float32)
+    actual = topk_from_pooled_history_logits(
+        logits,
+        torch.tensor([512], device="cuda", dtype=torch.int32),
+        4,
+        2048,
+        seq_lens=torch.tensor([2049], device="cuda", dtype=torch.int32),
+    )
+    expected = torch.cat(
+        (
+            torch.arange(2049, device="cuda", dtype=torch.int32),
+            torch.full((2,), -1, device="cuda", dtype=torch.int32),
+        )
+    )[None]
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
